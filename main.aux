\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Schwinger boson Ansätze associated with the six magnetic phases of \cref  {tab:phases}. Blue arrows denote real singlet amplitudes $A_{ij}$, black and gray arrows denote real and imaginary hopping amplitudes $B_{ij}$. The colored ellipses show the correlators $\langle \boldsymbol  {S}^{\mathrm  {EP}}\rangle $ evaluated in the gapped spin-liquid regime. For the Ansatz of phase $C$ the staggered chirality pattern $\langle \boldsymbol  {\chi }^{\mathrm  {EP}}\rangle $ is nonzero as well. Adapted from Ref.~\blx@tocontentsinit {0}\cite {Sobral2025}.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:ansaetze}{{6}{9}{Schwinger boson Ansätze associated with the six magnetic phases of \cref {tab:phases}. Blue arrows denote real singlet amplitudes $A_{ij}$, black and gray arrows denote real and imaginary hopping amplitudes $B_{ij}$. The colored ellipses show the correlators $\langle \SEP \rangle $ evaluated in the gapped spin-liquid regime. For the Ansatz of phase $C$ the staggered chirality pattern $\langle \chiEP \rangle $ is nonzero as well. Adapted from Ref.~\cite {Sobral2025}}{figure.6}{}}
\newlabel{fig:ansaetze@cref}{{[figure][6][]6}{[1][8][]9}}
